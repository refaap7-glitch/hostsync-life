# Express backend URL, reachable from the Next.js server (not the browser).
API_URL="http://localhost:4000"
# Must match server/.env's INTERNAL_API_KEY exactly.
INTERNAL_API_KEY="change-me-too"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Optional: leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" together with the two vars above to show the "Continue with
# Google" button (NEXT_PUBLIC_* is inlined at build time, unlike the server-only vars).
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
