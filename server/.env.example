# PostgreSQL connection string (e.g. from neon.tech)
DATABASE_URL="postgresql://user:password@host:5432/hostsync?sslmode=require"

PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
# Shared secret the Next.js server-side route handlers must send on every
# request; rejects any call that didn't come from our own frontend proxy.
INTERNAL_API_KEY="change-me-too"

# Public origin of the Next.js app, for CORS.
WEB_ORIGIN="http://localhost:3000"

# --- Adapter selection -------------------------------------------------
# Each defaults to the mock implementation when unset/false, so the app
# runs fully simulated with zero external credentials.
USE_REAL_WHATSAPP=false
USE_REAL_PAYMENTS=false

# Twilio WhatsApp (only read when USE_REAL_WHATSAPP=true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# MercadoPago (only read when USE_REAL_PAYMENTS=true)
MERCADOPAGO_ACCESS_TOKEN=

# Where uploaded task-completion photos are written and served from.
UPLOADS_DIR=uploads
PUBLIC_UPLOADS_URL="http://localhost:4000/uploads"
